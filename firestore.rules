rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write to test connection path
    match /test/{testId} {
      allow read, write: if true;
    }

    // Allow read/write for library catalog and sync documents
    match /library/{docId} {
      allow read, write: if true;
    }

    // Allow read/write for individual game documents
    match /games/{gameId} {
      allow read, write: if true;
    }

    // Fallback for all other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
