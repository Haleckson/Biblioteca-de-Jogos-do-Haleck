{
  "entities": {
    "Game": {
      "title": "Game",
      "description": "Video game library item with metadata, playtime, ratings and diary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "platform": { "type": "string" },
        "status": { "type": "array" }
      },
      "required": ["id", "name"]
    },
    "WoWIdEntity": {
      "title": "WoWIdEntity",
      "description": "Comprehensive World of Warcraft ID database entity tracking items, spells, displays, mounts, creatures, pets and relationships",
      "type": "object",
      "properties": {
        "idType": { "type": "string" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "displayId": { "type": "number" },
        "spellId": { "type": "number" },
        "relations": { "type": "array" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["idType", "id"]
    },
    "LibraryData": {
      "title": "LibraryData",
      "description": "User game library data container",
      "type": "object",
      "properties": {
        "games": { "type": "array" },
        "globalTags": { "type": "array" },
        "globalGenres": { "type": "array" },
        "lastUpdated": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/library/{docId}": {
      "schema": "LibraryData",
      "description": "Global game library and user games data"
    },
    "/games/{gameId}": {
      "schema": "Game",
      "description": "Individual game records"
    },
    "/wow_database_ids/{docId}": {
      "schema": "WoWIdEntity",
      "description": "Global World of Warcraft ID database records and relationships"
    },
    "/test/{testId}": {
      "schema": "LibraryData",
      "description": "Connection test documents"
    }
  }
}
